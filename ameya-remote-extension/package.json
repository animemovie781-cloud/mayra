{
  "name": "ameya-remote",
  "displayName": "Ameya Remote Session",
  "description": "High-performance bridge between Ameya (Android) and your development environment - enabling remote workspace interaction via WebSocket",
  "icon": "icon.png",
  "version": "1.0.0",
  "publisher": "nazrielnr",
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/nazrielnr/ameya.git",
    "directory": "ameya-remote-extension"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ameyaRemote.startServer",
        "title": "Ameya Remote: Start Server"
      },
      {
        "command": "ameyaRemote.stopServer",
        "title": "Ameya Remote: Stop Server"
      },
      {
        "command": "ameyaRemote.setCredentials",
        "title": "Ameya Remote: Set Credentials (Manual)"
      },
      {
        "command": "ameyaRemote.diagnose",
        "title": "Ameya Remote: Diagnose Connection"
      }
    ],
    "configuration": {
      "title": "Ameya Remote",
      "properties": {
        "ameyaRemote.port": {
          "type": "number",
          "default": 8765,
          "description": "WebSocket server port for Ameya connections"
        },
        "ameyaRemote.autoStart": {
          "type": "boolean",
          "default": false,
          "description": "Automatically start the WebSocket server when Antigravity launches"
        },
        "ameyaRemote.provider": {
          "type": "string",
          "default": "antigravity",
          "enum": [
            "antigravity",
            "stub"
          ],
          "description": "Provider backend used by Ameya Remote (foundation for multi-IDE support)"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test:provider-contracts": "node test/provider-contracts.js",
    "test:normalizer-contracts": "node test/normalizer-contracts.js"
  },
  "dependencies": {
    "module-alias": "^2.3.4",
    "qrcode": "^1.5.4",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/qrcode": "^1.5.6",
    "@types/vscode": "^1.80.0",
    "@types/ws": "^8.5.10",
    "typescript": "^5.3.0"
  }
}